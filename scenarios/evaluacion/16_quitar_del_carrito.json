{
  "id": "16_quitar_del_carrito",
  "title": "Dos productos y quitar uno",
  "kind": "quitar_del_carrito",
  "voice": false,
  "description": "El usuario añade dos productos en un mismo turno, quita el primero y compra. El pedido solo debe llevar el segundo y el inventario del primero no debe cambiar.",
  "steps": [
    {
      "say": "Busco un teclado inalámbrico.",
      "expect": [
        {
          "check": "cart",
          "empty": true
        }
      ]
    },
    {
      "remember": {
        "primero": "candidate:1",
        "segundo": "candidate:2"
      }
    },
    {
      "event": "set_offer",
      "product": "@primero",
      "price_cents": 1500,
      "stock": 20
    },
    {
      "event": "set_offer",
      "product": "@segundo",
      "price_cents": 1800,
      "stock": 20
    },
    {
      "say": "Añade uno del primero y uno del segundo.",
      "expect": [
        {
          "check": "cart",
          "lines": [
            {
              "product": "@primero",
              "quantity": 1
            },
            {
              "product": "@segundo",
              "quantity": 1
            }
          ]
        }
      ]
    },
    {
      "say": "Quita el primero.",
      "expect": [
        {
          "check": "cart",
          "lines": [
            {
              "product": "@segundo",
              "quantity": 1
            }
          ]
        }
      ]
    },
    {
      "say": "Cierra el pedido.",
      "expect": [
        {
          "check": "awaiting_confirmation",
          "value": true
        },
        {
          "check": "orders",
          "count": 0
        }
      ]
    },
    {
      "say": "Sí.",
      "expect": [
        {
          "check": "orders",
          "count": 1
        }
      ]
    }
  ],
  "expect": [
    {
      "check": "orders",
      "count": 1
    },
    {
      "check": "order",
      "lines": [
        {
          "product": "@segundo",
          "quantity": 1
        }
      ],
      "total_cents": 1800
    },
    {
      "check": "stock",
      "product": "@primero",
      "equals": 20
    },
    {
      "check": "stock",
      "product": "@segundo",
      "equals": 19
    },
    {
      "check": "cart",
      "empty": true
    }
  ]
}
