# Copia este archivo a .env (no se versiona) y ajusta los valores a tu máquina.

# Carpeta donde Hugging Face descarga los modelos (embeddings, LLM en GGUF).
# Útil si el disco del sistema tiene poco espacio.
# HF_HOME=/ruta/a/un/disco/grande/huggingface

# Postgres para los checkpoints y el Store de LangGraph.
# Sin esta variable el agente usa memoria volátil (se pierde al cerrar el proceso).
# SHOPPING_AGENT_PG_URL=postgresql://usuario:clave@localhost:5432/shopping_agent

# LLM local (GGUF). Por defecto se descarga el modelo indicado en documentation/PLAN.md.
# SHOPPING_AGENT_LLM_REPO=
# SHOPPING_AGENT_LLM_FILE=
# SHOPPING_AGENT_LLM_PATH=/ruta/a/un/modelo.gguf
