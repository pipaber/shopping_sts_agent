# Copia este archivo a .env (no se versiona) y ajusta los valores a tu máquina.

# Carpeta donde Hugging Face descarga los modelos (embeddings, LLM en GGUF).
# Útil si el disco del sistema tiene poco espacio.
# HF_HOME=/ruta/a/un/disco/grande/huggingface

# Postgres para los checkpoints y el Store de LangGraph. Es obligatoria: sin ella los
# comandos se detienen, salvo que se pida la memoria volátil con --volatile-memory.
# SHOPPING_AGENT_PG_URL=postgresql://usuario:clave@localhost:5432/shopping_agent

# LLM local (GGUF). Por defecto se descarga el modelo indicado en documentation/PLAN.md.
# Repositorio y fichero de Hugging Face (si está partido, el nombre de la primera parte):
# SHOPPING_AGENT_LLM_REPO=Qwen/Qwen2.5-7B-Instruct-GGUF
# SHOPPING_AGENT_LLM_FILE=qwen2.5-7b-instruct-q4_k_m-00001-of-00002.gguf
# O bien un GGUF que ya esté en disco:
# SHOPPING_AGENT_LLM_PATH=/ruta/a/un/modelo.gguf

# Reranker GraphSAGE sobre los 50 primeros de la búsqueda híbrida: "on" (por defecto)
# u "off". Activado necesita los pesos, que se generan con:
# python -m shopping_agent.retrieval.train
# SHOPPING_AGENT_RERANKER=off

# --- Voz ---
# Grabación de referencia para clonar la voz del agente (propia o autorizada).
# Por defecto se busca en audio/referencia/referencia.wav; audio/ no se versiona
# porque la voz es un dato personal.
# SHOPPING_AGENT_VOICE_REF=audio/referencia/referencia.wav
# Solo para pruebas, mientras no haya grabación: un hablante incluido en XTTS-v2
# (lista: python -m shopping_agent.voice.tts --list-speakers).
# SHOPPING_AGENT_TTS_SPEAKER=
# Carpeta de datos de coqui-tts (el modelo en sí se descarga en HF_HOME).
# TTS_HOME=/ruta/a/un/disco/grande/tts
# XTTS-v2 exige aceptar la licencia CPML de Coqui (uso no comercial):
# https://tts-hub.github.io/cpml. Descomenta esta línea solo si la has leído y la aceptas.
# COQUI_TOS_AGREED=1
# Modelo de Whisper (por defecto, large-v3-turbo).
# SHOPPING_AGENT_ASR_MODEL=large-v3-turbo
